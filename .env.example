# --- Database (PostgreSQL) -------------------------------------------------
# Option A — Docker: `docker compose up -d db`, then use this line.
DATABASE_URL="postgresql://nimday:nimday@localhost:5432/nimday?schema=public"
# Option B — zero-infra PGlite: `npm run db:dev` in another shell, then use:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?pgbouncer=true&connection_limit=1"

# --- Auth ----------------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: `openssl rand -base64 48`
AUTH_SECRET="dev-only-change-me-please-32-bytes-minimum-abcdef"
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS="604800"
# Auth nonce lifetime in seconds (default 5 minutes)
AUTH_NONCE_TTL_SECONDS="300"

# --- App ---------------------------------------------------------------
# Public origin used to build share links / deep links. No trailing slash.
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"

# --- Dev-only helpers ---------------------------------------------------
# Enables POST /api/auth/dev-login (real crypto, deterministic keypair, no device).
# NEVER set in production. Requires NODE_ENV !== "production".
ALLOW_DEV_LOGIN="1"
# Shows the "Use a test wallet" button in the creator flow.
NEXT_PUBLIC_ALLOW_DEV_WALLET="1"

# --- Image storage --------------------------------------------------------
# "local"  -> writes to ./storage-uploads, served via /api/uploads/<id> (dev default)
# "s3"     -> not implemented in Phase 1; abstraction is ready in src/lib/storage
STORAGE_DRIVER="local"
