# --- Database (PostgreSQL) -------------------------------------------------
# Option A — Docker: `docker compose up -d db`, then use this line.
DATABASE_URL="postgresql://nimday:nimday@localhost:5432/nimday?schema=public"
# Option B — zero-infra PGlite: `npm run db:dev` in another shell, then use:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?pgbouncer=true&connection_limit=1"
#
# Direct, unpooled connection — used ONLY by `prisma migrate`. Locally there is
# no pooler, so set it to the same value as DATABASE_URL. In production behind a
# pooler (Supabase, pgBouncer), DATABASE_URL is the pooled port and this is the
# direct one.
DIRECT_URL="postgresql://nimday:nimday@localhost:5432/nimday?schema=public"

# --- Auth ----------------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: `openssl rand -base64 48`
AUTH_SECRET="dev-only-change-me-please-32-bytes-minimum-abcdef"
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS="604800"
# Auth nonce lifetime in seconds (default 5 minutes)
AUTH_NONCE_TTL_SECONDS="300"

# --- App ---------------------------------------------------------------
# Public origin used to build share links / deep links. No trailing slash.
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"

# --- Verification worker (Phase 2) ------------------------------------
# Nimiq network for the @nimiq/core light client. Default: mainalbatross.
NIMIQ_NETWORK="mainalbatross"
# Worker poll interval in ms (default 8000).
WORKER_TICK_MS="8000"

# --- Dev-only helpers ---------------------------------------------------
# Enables POST /api/auth/dev-login and POST /api/dev/mock-verify
# (real crypto / real verification code path, no device or live worker needed).
# NEVER set in production. Requires NODE_ENV !== "production".
ALLOW_DEV_LOGIN="1"
# Shows the "Use a test wallet" button in the creator flow.
NEXT_PUBLIC_ALLOW_DEV_WALLET="1"

# --- Image storage --------------------------------------------------------
# "local"    -> ./storage-uploads, served via /api/uploads/<id>. Dev default.
#               NOT durable on Vercel (read-only disk) or any container that is
#               redeployed — uploads vanish. Use "supabase" there.
# "supabase" -> Supabase Storage; images are served from Supabase's CDN.
# Anything else throws at startup rather than silently writing to local disk.
STORAGE_DRIVER="local"

# Required when STORAGE_DRIVER="supabase".
# Create a bucket in Supabase -> Storage, and make it public (read).
# SUPABASE_URL="https://<project-ref>.supabase.co"
# The SERVICE ROLE key (Settings -> API), never the anon/publishable key, and
# never NEXT_PUBLIC_ — it is server-side only and bypasses row-level security.
# SUPABASE_SERVICE_ROLE_KEY="..."
# Bucket name. Defaults to "nimday-uploads" when omitted.
# SUPABASE_STORAGE_BUCKET="nimday-uploads"
