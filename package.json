{
  "name": "nimday",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --tsconfig tsconfig.scripts.json worker/index.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "node scripts/dev-db.mjs .pglite",
    "dev:gift": "tsx --tsconfig tsconfig.scripts.json scripts/dev-gift.ts",
    "e2e:phase3": "node scripts/e2e-phase3.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nimiq/core": "2.21.0",
    "@nimiq/mini-app-sdk": "0.1.0",
    "@prisma/client": "6.3.1",
    "jose": "5.9.6",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "4.19.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "8.5.1",
    "prisma": "6.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
